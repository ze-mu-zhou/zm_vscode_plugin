{
  "name": "zemu-python-check",
  "displayName": "Zemu_python_check",
  "description": "zemu-python-check",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.132.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ze-mu-zhou/zm_vscode_plugin.git"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:python",
    "onCustomEditor:zemu.pycViewer"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "basic_python_scan",
        "title": "基础 python 下限版本扫描",
        "category": "ZM_python",
        "enablement": "editorLangId == python"
      },
      {
        "command": "zemu.decompilePycToPy",
        "title": "反编译为临时 py 并打开",
        "category": "ZM_python"
      },
      {
        "command": "zemu.cleanupTmpPython",
        "title": "清理临时反编译文件",
        "category": "ZM_python"
      }
    ],
    "customEditors": [
      {
        "viewType": "zemu.pycViewer",
        "displayName": "Pyc 反编译查看器",
        "selector": [
          {
            "filenamePattern": "*.pyc"
          }
        ],
        "priority": "default"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "zemu.decompilePycToPy",
          "when": "resourceExtname == .pyc",
          "group": "ZM_python@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.123.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "python-shell": "^5.0.0"
  }
}
